# WiFiRouter V2 Configuration Template

# Database Configuration (PostgreSQL in production, SQLite fallback for local development)
DATABASE_URL=postgresql+asyncpg://wifirouter:wifirouter_secure_pg_pass_2026@localhost:5432/wifirouter
POSTGRES_DB=wifirouter
POSTGRES_USER=wifirouter
POSTGRES_PASSWORD=wifirouter_secure_pg_pass_2026

# Security & Session Authentication
WIFIROUTER_SECRET_KEY=replace-with-a-random-64-char-secret-key-in-production
WIFIROUTER_AGENT_SECRET=replace-with-a-random-32-char-agent-key-in-production

# Network Interfaces
WIFIROUTER_LAN_IFACE=enp1s0
WIFIROUTER_WAN_IFACE=wlp2s0
WIFIROUTER_GATEWAY_IP=192.168.16.2

# Agent IPC Binding
WIFIROUTER_AGENT_HOST=127.0.0.1
WIFIROUTER_AGENT_PORT=8091
WIFIROUTER_AGENT_URL=http://127.0.0.1:8091

# Initial Administrator Credentials
WIFIROUTER_ADMIN_USER=admin
WIFIROUTER_ADMIN_PASSWORD=change_this_admin_password_123!

# Simulation mode (set to 1 to simulate Linux tools on non-Linux environments)
WIFIROUTER_SIMULATE=0

